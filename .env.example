PORT=3000
ADMIN_KEY=change-me
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Leave MONGODB_URI empty to use in-memory repositories (data is lost on restart).
MONGODB_URI=
MONGODB_DB=complynexus_lite

# Email. Leave both empty to print notifications to the console.
RESEND_API_KEY=
MAIL_FROM=ComplyNexus Lite <noreply@complynexus.com>

# Public origin used in verify pages and badge links (no trailing slash). Empty derives it from the request.
PUBLIC_BASE_URL=
# Set to 1 behind a reverse proxy (Render) so rate limiting sees the client IP.
TRUST_PROXY=0
LOG_LEVEL=info

# 1 enables POST /auth/dev-link (admin key required). Staging acceptance only.
ALLOW_DEV_LOGIN=0

# HMAC secret for /app form tokens. Falls back to ADMIN_KEY, then a random per-process value.
CSRF_SECRET=
