    "@types/express": "4.17.21",
    "@types/node": "20.17.9",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.15.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.9"
  }
