    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
