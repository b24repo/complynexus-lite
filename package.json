  "private": true,
  "description": "ComplyNexus Lite POC sprint 0: record domain, guided self-test, verify page",
  "license": "UNLICENSED",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
